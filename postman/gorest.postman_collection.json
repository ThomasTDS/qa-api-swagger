{
  "info": {
    "_postman_id": "b6f2a2b0-4d3e-4c8a-9e2a-1f7a6c9d3e10",
    "name": "GoRest API - Users",
    "description": "Collection Postman gerada a partir de openapi/gorest-openapi.yaml, com scripts de teste (asserções) para cada requisição. Serve como forma alternativa de execução dos testes de contrato, via Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://gorest.co.in/public/v2", "type": "string" },
    { "key": "bearerToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "existingEmail", "value": "", "type": "string" },
    { "key": "createdUserId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Users - Leitura (sem autenticação)",
      "item": [
        {
          "name": "Listar usuários",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/users?page=1",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [{ "key": "page", "value": "1" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('retorna uma lista não vazia', () => {",
                  "  pm.expect(Array.isArray(body)).to.be.true;",
                  "  pm.expect(body.length).to.be.greaterThan(0);",
                  "});",
                  "pm.collectionVariables.set('userId', body[0].id);",
                  "pm.collectionVariables.set('existingEmail', body[0].email);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Buscar usuário existente por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('id retornado bate com o solicitado', () => {",
                  "  pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Buscar ID inexistente",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["users", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('mensagem de erro esperada', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Resource not found');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Buscar ID em formato inválido",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/users/abc",
              "host": ["{{baseUrl}}"],
              "path": ["users", "abc"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404 (ver issue documentada no repositório)', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Filtrar gender fora do enum",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/users?gender=alien",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [{ "key": "gender", "value": "alien" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 com lista vazia (ver issue documentada no repositório)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.eql([]);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Users - Escrita (autenticado)",
      "item": [
        {
          "name": "Criar usuário",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{bearerToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Portfolio Newman\",\n  \"email\": \"{{$randomEmail}}\",\n  \"gender\": \"male\",\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('usuário criado com nome correto', () => {",
                  "  pm.expect(body.name).to.eql('QA Portfolio Newman');",
                  "});",
                  "pm.collectionVariables.set('createdUserId', body.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Atualizar usuário criado",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{bearerToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{createdUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{createdUserId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status atualizado para inactive', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('inactive');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Criar sem campo obrigatório name",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{bearerToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\",\n  \"gender\": \"male\",\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('erro de validação aponta o campo name', () => {",
                  "  const fields = pm.response.json().map((e) => e.field);",
                  "  pm.expect(fields).to.include('name');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Criar com email já cadastrado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{bearerToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Portfolio Email Duplicado\",\n  \"email\": \"{{existingEmail}}\",\n  \"gender\": \"male\",\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('erro de validação aponta o campo email como já usado', () => {",
                  "  const errors = pm.response.json();",
                  "  const emailError = errors.find((e) => e.field === 'email');",
                  "  pm.expect(emailError.message).to.include('taken');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Criar sem token de autenticação",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Portfolio Sem Token\",\n  \"email\": \"{{$randomEmail}}\",\n  \"gender\": \"male\",\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('mensagem de erro esperada', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Authentication failed');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Remover usuário criado",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{bearerToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{createdUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{createdUserId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
