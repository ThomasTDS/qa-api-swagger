{
  "name": "qa-api-swagger",
  "version": "1.0.0",
  "description": "Testes automatizados de API para o GoRest, documentados com OpenAPI/Swagger",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "validate:openapi": "swagger-cli validate openapi/gorest-openapi.yaml",
    "postman:run": "node scripts/run-newman.js",
    "postman:run:read-only": "node scripts/run-newman.js --read-only",
    "prepare": "husky"
  },
  "keywords": [
    "api-testing",
    "openapi",
    "swagger",
    "qa"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.js": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.9.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "jest-openapi": "^0.14.2",
    "lint-staged": "^17.5.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "swagger-cli": "^4.0.4"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5"
  }
}
